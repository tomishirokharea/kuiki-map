.unit.hl\{outline:4px solid var(--draw);outline-offset:2px\}\
.cardbar\{position:absolute;left:10px;right:64px;bottom:22px;z-index:500;background:var(--paper);border:3px solid var(--draw);border-radius:var(--r);padding:8px 12px;box-shadow:0 4px 12px #0004\}\
.cardbar p\{margin:0\}\
.nowtag\{display:inline-block;background:var(--ink);color:#fff;border-radius:6px;padding:0 6px;font-size:14px;vertical-align:middle\}\
.btn:disabled\{opacity:.45;cursor:not-allowed\}\
.slotpick\{width:100%;border-collapse:collapse;text-align:center;margin:8px 0\}\
.slotpick th\{font-size:15px;padding:4px 2px;font-weight:700\}\
.slotpick th small\{font-weight:400;font-size:11px\}\
.slotpick td\{padding:3px\}\
.slotbtn\{width:100%;min-width:44px;height:54px;border-radius:10px;border:2px solid var(--ink2);background:#fff;font-size:24px;font-weight:700\}\
.slotbtn[aria-pressed="true"]\{background:var(--ink);color:#fff;border-color:var(--ink)\}\
.slots td.thin\{background:var(--warn-bg);outline:3px solid var(--away);outline-offset:-3px\}\
.tag-warn\{background:var(--warn-bg);color:#6B4200;border-radius:8px;padding:0 8px;font-weight:700\}\
\
/* ===== \uc0\u12362 \u30693 \u12425 \u12379  ===== */\
#toast\{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(84px + env(safe-area-inset-bottom));z-index:3000;background:var(--ink);color:#fff;border-radius:14px;padding:10px 14px;display:flex;align-items:center;gap:12px;box-shadow:0 4px 14px #0005;width:max-content;max-width:calc(100% - 24px);font-size:17px\}\
#toast button\{min-height:46px;border-radius:10px;border:2px solid #fff;background:transparent;color:#fff;font-weight:700;padding:0 14px;flex:none\}\
