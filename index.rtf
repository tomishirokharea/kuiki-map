  $('#backdrop').onclick = closeSheet;\
  document.addEventListener('keydown', e => \{\
    if (e.key !== 'Escape') return;\
    if (!$('#sheet').hidden) closeSheet();\
    else if (draw) endDraw();\
    else if (mode !== 'normal') setMode('normal');\
  \});\
\
  // \uc0\u21306 \u22495 \u12459 \u12540 \u12489 \u12539 \u33258 \u20998 \u12398 \u20877 \u35370 \u21839 \
  $('#view-cards').addEventListener('click', e => \{\
    const q = sel => e.target.closest(sel);\
    let x;\
    if ((x = q('[data-open]'))) openTerr(x.dataset.open);\
    else if ((x = q('[data-go]'))) goTo(x.dataset.go, x.dataset.unit);\
    else if ((x = q('[data-fact]'))) followAction(x.dataset.fact, x.dataset.key);\
    else if ((x = q('[data-scroll]'))) $('#' + x.dataset.scroll).scrollIntoView(\{ behavior: 'smooth', block: 'start' \});\
    else if (q('[data-reqopen]')) openRequestSheet();\
    else if ((x = q('[data-reqcancel]'))) \{\
      const id = x.dataset.reqcancel;\
      if (!confirm('\uc0\u30003 \u12375 \u36796 \u12415 \u12434 \u21462 \u12426 \u28040 \u12375 \u12414 \u12377 \u12290 \u12424 \u12429 \u12375 \u12356 \u12391 \u12377 \u12363 \u65311 ')) return;\
      commit('\uc0\u30003 \u12375 \u36796 \u12415 \u12434 \u21462 \u12426 \u28040 \u12375 \u12414 \u12375 \u12383 ', () => \{ D().requests = D().requests.filter(r => r.id !== id); \});\
    \}\
    else if ((x = q('[data-reqseen]'))) \{\
      const r = D().requests.find(r => r.id === x.dataset.reqseen);\
      if (r) \{ r.seen = true; Store.save(); renderAll(); \}\
    \}\
    else if ((x = q('[data-return]'))) openReturnSheet(x.dataset.return);\
    else if ((x = q('[data-awayopen]'))) openAwayCard(x.dataset.awayopen);\
    else if ((x = q('[data-awayend]'))) endAwayCard(x.dataset.awayend);\
  \});\
\
  // \uc0\u22320 \u22259 \
  $('#terrJump').onchange = e => \{\
    const v = e.target.value, t = terrById(v);\
    focusCard = null;\
    roundTerr = t && t.holder === me().id ? v : null;\
    renderTerrs(); renderHouses();\
    if (v) fitTerr(v);\
  \};\
  $('#btnAdd').onclick = () => \{ setMode('add'); if (map.getZoom() < 17) toast('\uc0\u22580 \u25152 \u12364 \u12431 \u12363 \u12427 \u12414 \u12391 \u22320 \u22259 \u12434 \u25313 \u22823 \u12375 \u12390 \u12363 \u12425 \u12479 \u12483 \u12503 \u12375 \u12390 \u12367 \u12384 \u12373 \u12356 '); \};\
  $('#addCancel').onclick = () => \{ closeSheet(); setMode('normal'); \};\
  $('#btnLocate').onclick = () => locate(() => map.setView(myPos, 18));\
  $('#btnBase').onclick = () => \{\
    map.removeLayer(baseLayers[baseName]);\
    baseName = baseName === 'pale' ? 'photo' : 'pale';\
    baseLayers[baseName].addTo(map);\
    $('#btnBase').textContent = baseName === 'pale' ? '\uc0\u20889 \u30495 ' : '\u22320 \u22259 ';\
  \};\
  $('#drawUndo').onclick = () => \{ draw.points.pop(); redrawDraw(); \};\
  $('#drawDone').onclick = finishDraw;\
  $('#drawCancel').onclick = () => \{ closeSheet(); endDraw(); \};\
  $('#ovFile').onchange = e => \{\
    const file = e.target.files[0]; if (!file) return;\
    const img = $('#overlayImg');\
    if (img.dataset.url) URL.revokeObjectURL(img.dataset.url);\
    const url = URL.createObjectURL(file);\
    img.src = url; img.dataset.url = url; img.hidden = false;\
    $('#ovCtl').hidden = false;\
    $('#map').classList.add('see-through');\
    applyOv();\
    toast('\uc0\u22320 \u22259 \u12434 \u21205 \u12363 \u12375 \u12390 \u12289 \u20889 \u30495 \u12398 \u36947 \u12392 \u37325 \u12394 \u12427 \u20301 \u32622 \u12395 \u21512 \u12431 \u12379 \u12390 \u12367 \u12384 \u12373 \u12356 ');\
    e.target.value = '';\
  \};\
  $('#ovRange').oninput = applyOv;\
  $('#ovClear').onclick = clearOverlay;\
\
  // \uc0\u12362 \u12377 \u12377 \u12417 \
  $('#recoChips').addEventListener('click', e => \{ const c = e.target.closest('[data-kind]'); if (c) \{ recoFilter = c.dataset.kind; renderReco(); \} \});\
  $('#recoMine').onchange = renderReco;\
  $('#recoLocate').onclick = () => locate(renderReco);\
  $('#slotEdit').onclick = openSlotSheet;\
  $('#awayList').addEventListener('click', e => \{\
    const x = e.target.closest('[data-awaytake]');\
    if (x && !x.disabled) takeAwayCard(x.dataset.awaytake, x.dataset.slot);\
  \});\
  $('#recoList').addEventListener('click', e => \{ const g = e.target.closest('[data-go]'); if (g) goTo(g.dataset.go, g.dataset.unit); \});\
\
  // \uc0\u20418 \u12398 \u30011 \u38754 \
  $('#adNewTerr').onclick = () => startDraw(null);\
  $('#adCsv').onclick = exportCsv;\
  $('#adReset').onclick = () => \{\
    if (!confirm('\uc0\u12371 \u12398 \u31471 \u26411 \u12398 \u35430 \u20316 \u12487 \u12540 \u12479 \u12434 \u26368 \u21021 \u12398 \u29366 \u24907 \u12395 \u25147 \u12375 \u12414 \u12377 \u12290 \u12424 \u12429 \u12375 \u12356 \u12391 \u12377 \u12363 \u65311 ')) return;\
    const cu = D().currentUser;\
    Store.data = makeDemo(); Store.data.currentUser = cu; Store.save();\
    fillWho(); updateTabs(); renderAll(); toast('\uc0\u35430 \u20316 \u12487 \u12540 \u12479 \u12395 \u25147 \u12375 \u12414 \u12375 \u12383 ');\
  \};\
  $('#view-admin').addEventListener('click', e => \{\
    const q = sel => e.target.closest(sel);\
    let x;\
    if ((x = q('[data-open]'))) openTerr(x.dataset.open);\
    else if ((x = q('[data-redraw]'))) startDraw(x.dataset.redraw);\
    else if ((x = q('[data-rename]'))) openTerrForm(\{ terr: terrById(x.dataset.rename) \});\
    else if ((x = q('[data-go]'))) goTo(x.dataset.go, x.dataset.unit);\
    else if ((x = q('[data-fact]'))) followAction(x.dataset.fact, x.dataset.key);\
    else if ((x = q('[data-set]'))) changeSetting(x.dataset.set, Number(x.dataset.d));\
    else if (q('#bkGo')) bulkMove();\
    else if ((x = q('[data-donepct]'))) \{\
      const st = D().settings;\
      st.donePct = Math.min(100, Math.max(50, st.donePct + Number(x.dataset.donepct)));\
      Store.save(); renderAll(); toast('\uc0\u23436 \u20102 \u12398 \u30446 \u23433 \u12434 \u22793 \u12360 \u12414 \u12375 \u12383 ');\
    \}\
    else if ((x = q('[data-aset]'))) \{\
      const st = D().settings, key = x.dataset.aset;\
      const lim = key === 'awayDays' ? [3, 14] : [1, 5];\
      st[key] = Math.min(lim[1], Math.max(lim[0], st[key] + Number(x.dataset.d)));\
      Store.save(); renderAll(); toast('\uc0\u35373 \u23450 \u12434 \u22793 \u12360 \u12414 \u12375 \u12383 ');\
    \}\
    else if ((x = q('[data-reqok]'))) approveReq(x.dataset.reqok);\
    else if ((x = q('[data-reqno]'))) declineReq(x.dataset.reqno);\
    else if ((x = q('[data-takenseen]'))) \{ const t = terrById(x.dataset.takenseen); if (t) \{ t.selfSeen = true; Store.save(); renderAll(); \} \}\
    else if ((x = q('[data-takemax]'))) \{\
      const st = D().settings;\
      st.selfTakeMax = Math.min(5, Math.max(1, st.selfTakeMax + Number(x.dataset.takemax)));\
      Store.save(); renderAll(); toast('\uc0\u26522 \u25968 \u12434 \u22793 \u12360 \u12414 \u12375 \u12383 ');\
    \}\
  \});\
  $('#view-admin').addEventListener('change', e => \{\
    const s = e.target, k = s.dataset.assign || s.dataset.reassign;\
    if (!k || !s.value) return;\
    const cur = fol(k);\
    if (cur && cur.by === s.value) return;\
    const v = s.value;\
    commit(`$\{uname(v)\}\uc0\u12373 \u12435 \u12364 \u20877 \u35370 \u21839 \u12434 \u21463 \u12369 \u25345 \u12385 \u12414 \u12377 `, () => startFollow(k, v));\
  \});\
  $('#adTerrs').addEventListener('change', e => \{\
    const fr = e.target.closest('[data-free]');\
    if (fr) \{\
      const t = terrById(fr.dataset.free);\
      t.free = fr.checked; Store.save(); renderAll();\
      toast(t.free ? `\uc0\u21306 \u22495 $\{t.no\}\u12434 \u33258 \u30001 \u12395 \u21463 \u12369 \u21462 \u12428 \u12427 \u12424 \u12358 \u12395 \u12375 \u12414 \u12375 \u12383 ` : `\u21306 \u22495 $\{t.no\}\u12399 \u20418 \u12364 \u27770 \u12417 \u12427 \u21306 \u22495 \u12395 \u12375 \u12414 \u12375 \u12383 `);\
      return;\
    \}\
    const s = e.target.closest('[data-holder]'); if (!s) return;\
    const t = terrById(s.dataset.holder), val = s.value;\
    if (!val) \{ renderAll(); openReturnSheet(t.id); return; \} // \uc0\u36820 \u21364 \u12399 \u12300 \u20840 \u37096 \u22238 \u12387 \u12383 \u12363 \u12301 \u12434 \u30906 \u35469 \u12377 \u12427 \
    commit(`\uc0\u21306 \u22495 $\{t.no\}\u12434 $\{uname(val)\}\u12373 \u12435 \u12395 \u36024 \u12375 \u20986 \u12375 \u12414 \u12375 \u12383 `, () => \{\
      t.holder = val;\
      t.lentAt = new Date().toISOString();\
    \});\
  \});\
\}\
\
async function init() \{\
  if (!window.L) \{\
    document.body.innerHTML = '<p style="padding:24px;font-size:20px">\uc0\u22320 \u22259 \u12398 \u37096 \u21697 \u12434 \u35501 \u12415 \u36796 \u12417 \u12414 \u12379 \u12435 \u12391 \u12375 \u12383 \u12290 \u12452 \u12531 \u12479 \u12540 \u12493 \u12483 \u12488 \u12395 \u12388 \u12394 \u12364 \u12387 \u12390 \u12356 \u12427 \u12363 \u30906 \u35469 \u12375 \u12390 \u12289 \u12418 \u12358 \u19968 \u24230 \u38283 \u12356 \u12390 \u12367 \u12384 \u12373 \u12356 \u12290 </p>';\
    return;\
  \}\
  if (LIVE) \{\
    showBlocking('\uc0\u35501 \u12415 \u36796 \u12435 \u12391 \u12356 \u12414 \u12377 \'85', '\u12375 \u12400 \u12425 \u12367 \u12362 \u24453 \u12385 \u12367 \u12384 \u12373 \u12356 \u12290 ');\
    try \{\
      await Store.loadLive();\
    \} catch (e) \{\
      if (e.code === 'auth') showBlocking('\uc0\u12371 \u12398 \u12522 \u12531 \u12463 \u12391 \u12399 \u38283 \u12369 \u12414 \u12379 \u12435 ', '\u21306 \u22495 \u20418 \u12363 \u12425 \u12418 \u12425 \u12387 \u12383 \u25307 \u24453 \u12522 \u12531 \u12463 \u12434 \u38283 \u12356 \u12390 \u12367 \u12384 \u12373 \u12356 \u12290 ');\
      else showBlocking('\uc0\u35501 \u12415 \u36796 \u12417 \u12414 \u12379 \u12435 \u12391 \u12375 \u12383 ', '\u12452 \u12531 \u12479 \u12540 \u12493 \u12483 \u12488 \u12395 \u12388 \u12394 \u12364 \u12387 \u12390 \u12356 \u12427 \u12363 \u30906 \u35469 \u12375 \u12390 \u12289 \u12418 \u12358 \u19968 \u24230 \u38283 \u12356 \u12390 \u12367 \u12384 \u12373 \u12356 \u12290 ');\
      return;\
    \}\
    hideBlocking();\
  \} else \{\
    Store.load();\
  \}\
  initMap();\
  bindStatic();\
  fillWho();\
  updateTabs();\
  renderAll();\
  showView('cards');\
  if (LIVE) \{\
    $('#modePill').hidden = true;\
    $('#whoSel').hidden = true; $('#whoLabel').hidden = true;\
    $('#whoName').hidden = false; $('#whoName').textContent = `$\{me().name\}\uc0\u12373 \u12435 `;\
    $('#liveTools').hidden = false;\
    $('#adReset').hidden = true;\
    $('#btnLogout').onclick = logout;\
    const again = () => \{ if (document.hidden) return; if (Store.queue.length) flush(); else refresh().catch(() => \{\}); \};\
    setInterval(again, 90000);\
    window.addEventListener('online', flush);\
    document.addEventListener('visibilitychange', again);\
    flush();\
  \}\
\}\
init();\
</script>\
